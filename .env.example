# Copy to `.env` and fill in. Never commit the real .env.
# The app validates this file at boot and exits non-zero on anything missing or malformed,
# so a typo is a crash on startup rather than a 3am discovery.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# --- Datastores -------------------------------------------------------------
# Use the docker-compose service names locally (db / redis).
# Host ports are 5433/6380, not 5432/6379: a native Postgres or Redis already
# bound to loopback on the defaults shadows the container on macOS, and the app
# then talks to your personal instance instead of the compose one.
DATABASE_URL=postgres://shortener:shortener@localhost:5433/shortener
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6380

# --- Secrets ----------------------------------------------------------------
# HMAC-SHA-256 pepper for API key hashing. At least 32 random bytes.
# Generate:  openssl rand -base64 48
# Rotating this invalidates every issued API key. There is no recovery path.
APP_SECRET=dev-only-insecure-secret-change-me-before-deploying-anything-real

# --- Rate limiting (per window, per IP) -------------------------------------
# RATE_LIMIT_MAX is the default budget for every route. The auth routes
# override it, because registration is the tightest endpoint in the app.
# The counters live in Redis, so the budget is shared by every instance.
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_LOGIN_MAX=10

# --- Password hashing -------------------------------------------------------
# Argon2id. Defaults are the OWASP baseline (m=19456 KiB, t=2, p=1).
# Lower these only for a memory-constrained host: production REFUSES TO BOOT
# below the baseline, because a weakened setting is invisible until someone
# exfiltrates the table. Use @node-rs/argon2's prebuilt binaries; the `argon2`
# package needs a node-gyp toolchain.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Password length bounds, enforced in the route's JSON Schema.
# The maximum is not arbitrary: argon2 cost scales with input length, so an
# unbounded password field is a free CPU-burn primitive against /v1/auth/login.
# 12 is a deliberate floor above the NIST SP 800-63B minimum of 8; production
# refuses to boot below 8.
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=200